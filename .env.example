FACEIT_API_KEY=your_server_side_api_key_here
FACEIT_GAME_ID=cs2
APP_DATABASE_PATH=data/accounts.sqlite3
COOKIE_SECURE=false
# DATABASE_URL is optional; use a durable PostgreSQL database for hosted accounts.

# Steam Web API key is server-only; Steam OpenID sign-in itself does not require it.
STEAM_API_KEY=your_steam_web_api_key_here
PUBLIC_BASE_URL=http://127.0.0.1:8000
